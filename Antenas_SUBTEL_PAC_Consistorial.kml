<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Catastro Antenas SUBTEL y Proyecto Cobertura Celular - Centro Consistorial PAC</name>
    <open>1</open>
    <description><![CDATA[
      <h2>Tecnovoa Ltda. — Auditoría RF y Proyecto weBoost Office 200 LATAM</h2>
      <p><b>Recinto:</b> Centro Consistorial I. Municipalidad de Pedro Aguirre Cerda<br/>
      <b>Dirección:</b> Av. Presidente Salvador Allende N° 2029 esq. Club Hípico, Santiago<br/>
      <b>Coordenadas:</b> -33.488600, -70.665500<br/>
      <b>Contraparte Cliente:</b> Álvaro O. Carreño Cerda — Jefe Depto. Informática (SECPLA)<br/>
      <b>KAM TI Tecnovoa:</b> Cristián Díaz (cristian@tecnovoa.cl / +569 4943 8288)<br/>
      <b>Web App Interactiva:</b> <a href="https://crdiazu.github.io/analizador-celular-pac/">https://crdiazu.github.io/analizador-celular-pac/</a></p>
      <hr/>
      <p>Este archivo KML contiene las <b>10 estaciones base registradas oficialmente en SUBTEL</b> en un radio de &lt; 750 m, los vectores de enlace 3D hacia la azotea y los puntos críticos de medición indoor/subterráneo.</p>
    ]]></description>

    <!-- ESTILOS KML (Colores aabbggrr) -->
    <!-- Tecnovoa / Edificio Principal -->
    <Style id="styleEdificio">
      <IconStyle>
        <scale>1.4</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/shapes/office_building.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff145fa0</color>
        <scale>1.1</scale>
      </LabelStyle>
      <BalloonStyle>
        <bgColor>ffffffff</bgColor>
        <text><![CDATA[
          <div style="font-family:Arial,sans-serif; min-width:280px;">
            <div style="background:#145fa0; color:#fff; padding:8px 12px; border-radius:4px 4px 0 0;">
              <h3 style="margin:0; font-size:16px;">$[name]</h3>
              <small>Tecnovoa — Proyecto In-Building</small>
            </div>
            <div style="padding:10px; font-size:13px; line-height:1.5;">
              $[description]
            </div>
          </div>
        ]]></text>
      </BalloonStyle>
    </Style>

