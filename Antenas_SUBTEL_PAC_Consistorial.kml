    <!-- ======================================================== -->
    <!-- FOLDER 1: CENTRO CONSISTORIAL PAC & PUNTOS DE MEDICIÓN   -->
    <!-- ======================================================== -->
    <Folder>
      <name>🏢 Centro Consistorial PAC &amp; Puntos de Inspección</name>
      <open>1</open>

      <Placemark>
        <name>Edificio Consistorial PAC (Acceso Principal)</name>
        <styleUrl>#styleEdificio</styleUrl>
        <description><![CDATA[
          <b>Dirección:</b> Av. Presidente Salvador Allende N° 2029<br/>
          <b>Comuna:</b> Pedro Aguirre Cerda, Región Metropolitana<br/>
          <b>Contacto:</b> Álvaro Carreño Cerda — Jefe Informática (SECPLA)<br/>
          <b>Diagnóstico RF:</b> Excelente cobertura exterior 4G/5G en fachada (-74 dBm). Apagón de señal en Piso -1 debido a doble losa de hormigón armado de 25 cm.<br/>
          <b>Solución Cotizada:</b> weBoost Office 200 LATAM (SKU 531047) — CLP$ 1.650.898 + IVA.
        ]]></description>
        <Point>
          <coordinates>-70.665500,-33.488600,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P1: Azotea Técnica (+8,25 m) — Punto Donante</name>
        <styleUrl>#styleDonante</styleUrl>
        <description><![CDATA[
          <b>Ubicación:</b> Ejes N-P / Shaft GI 07-08 (Azotea)<br/>
          <b>Elemento a Instalar:</b> Antena Exterior Omni Plus (314422) 360° + Protector Relámpago (859902)<br/>
          <b>Cota:</b> +8,25 m sobre nivel de calle<br/>
          <b>RSRP Donante Medido:</b> Entel: -72 dBm | Movistar: -74 dBm | Claro: -68 dBm | WOM: -70 dBm<br/>
          <b>Bajada Coaxial:</b> 18,28 m Wilson400 (SKU 952360) hacia amplificador Office 200.
        ]]></description>
        <Point>
          <altitudeMode>relativeToGround</altitudeMode>
          <extrude>1</extrude>
          <coordinates>-70.665450,-33.488550,11</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P5: Oficina Técnicos Informática &amp; Bodega (Nivel -1)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Ubicación:</b> Ejes Q-R / Subterráneo Nivel -1 (Cota -3,20 m)<br/>
          <b>Zona Crítica 1:</b> 2 Técnicos Informática + Bodega<br/>
          <b>RSRP Promedio Actual:</b> -108 dBm (Zona sombría / borde de pérdida)<br/>
          <b>Estado Voz:</b> Cortes intermitentes, degradación a 3G inestable.
        ]]></description>
        <Point>
          <coordinates>-70.665420,-33.488620,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P6: Oficina Jefe Informática Álvaro Carreño (Nivel -1)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Ubicación:</b> Ejes R-S / Subterráneo Nivel -1 (Cota -3,20 m)<br/>
          <b>Zona Crítica 2 (ZONA MUERTA):</b> Oficina Jefatura Informática &amp; Emergencia<br/>
          <b>RSRP Promedio Actual:</b> -114 dBm | SINR &lt; 0 dB (Ruido domina)<br/>
          <b>Estado Voz:</b> CALL DROP (Llamadas se caen o no timbran)<br/>
          <b>Acción:</b> Punto objetivo de irradiación de la Antena Domo Interior (314407).
        ]]></description>
        <Point>
          <coordinates>-70.665380,-33.488650,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P8: Archivo Municipal e Inventario (Nivel -1)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Ubicación:</b> Ejes K-P / Fondo enterrado bajo losa maciza de patio central<br/>
          <b>Estado Actual:</b> APAGÓN TOTAL — RSRP &lt; -120 dBm / Sin Servicio (Solo Emergencias).
        ]]></description>
        <Point>
          <coordinates>-70.665250,-33.488750,0</coordinates>
        </Point>
      </Placemark>
    </Folder>

