<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Catastro Antenas SUBTEL y Proyecto Cobertura Celular - Centro Consistorial PAC</name>
    <open>1</open>
    <description><![CDATA[
      <h2>Tecnovoa Ltda. — Auditoría RF y Proyecto weBoost Office 200 LATAM</h2>
      <p><b>Recinto:</b> Centro Consistorial I. Municipalidad de Pedro Aguirre Cerda<br/>
      <b>Dirección:</b> Av. Presidente Salvador Allende N° 2029 esq. Club Hípico, Santiago<br/>
      <b>Contraparte Cliente:</b> Álvaro O. Carreño Cerda — Jefe Depto. Informática (SECPLA)<br/>
      <b>KAM TI Tecnovoa:</b> Cristián Díaz (cristian@tecnovoa.cl / +569 4943 8288)<br/>
      <b>Web App Interactiva:</b> <a href="https://crdiazu.github.io/analizador-celular-pac/">https://crdiazu.github.io/analizador-celular-pac/</a></p>
    ]]></description>

    <!-- Vista Inicial 3D Automática (Vuelo al Edificio) -->
    <LookAt>
      <longitude>-70.665500</longitude>
      <latitude>-33.488600</latitude>
      <altitude>0</altitude>
      <heading>320</heading>
      <tilt>55</tilt>
      <range>750</range>
      <altitudeMode>clampToGround</altitudeMode>
    </LookAt>

    <!-- ========================================== -->
    <!-- ESTILOS OFICIALES KML (Compatibilidad 100%) -->
    <!-- Formato de color: aabbggrr (Alpha-Blue-Green-Red) -->
    <!-- ========================================== -->

    <!-- Edificio Consistorial PAC -->
    <Style id="styleEdificio">
      <IconStyle>
        <scale>1.5</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href>
        </Icon>
        <color>ff145fa0</color>
      </IconStyle>
      <LabelStyle>
        <color>ffffffff</color>
        <scale>1.1</scale>
      </LabelStyle>
    </Style>

    <!-- Azotea Donante P1 -->
    <Style id="styleDonante">
      <IconStyle>
        <scale>1.4</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/shapes/target.png</href>
        </Icon>
        <color>ff00ff00</color>
      </IconStyle>
      <LabelStyle>
        <color>ff00ff00</color>
        <scale>1.1</scale>
      </LabelStyle>
      <LineStyle>
        <color>ff00ff00</color>
        <width>3</width>
      </LineStyle>
    </Style>

    <!-- Puntos Críticos Subterráneo / Zonas Muertas -->
    <Style id="stylePuntoCritico">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/red-diamond.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff0000ff</color>
        <scale>1.0</scale>
      </LabelStyle>
    </Style>

    <!-- Torre Claro (Rojo Opaco) -->
    <Style id="styleClaro">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff0000ff</color>
        <scale>0.95</scale>
      </LabelStyle>
      <LineStyle>
        <color>ff0000ff</color>
        <width>2.5</width>
      </LineStyle>
    </Style>

    <!-- Torre WOM (Magenta / Púrpura Brillante) -->
    <Style id="styleWOM">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/purple-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ffff00ff</color>
        <scale>0.95</scale>
      </LabelStyle>
      <LineStyle>
        <color>ffff00ff</color>
        <width>2.5</width>
      </LineStyle>
    </Style>

    <!-- Torre Entel (Azul Eléctrico Brillante) -->
    <Style id="styleEntel">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/blu-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ffffaa00</color>
        <scale>0.95</scale>
      </LabelStyle>
      <LineStyle>
        <color>ffffaa00</color>
        <width>2.5</width>
      </LineStyle>
    </Style>

    <!-- Torre Movistar (Verde Esmeralda Brillante) -->
    <Style id="styleMovistar">
      <IconStyle>
        <scale>1.3</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff00ff00</color>
        <scale>0.95</scale>
      </LabelStyle>
      <LineStyle>
        <color>ff00ff00</color>
        <width>2.5</width>
      </LineStyle>
    </Style>

    <!-- Torre Multi-Operador Compartida -->
    <Style id="styleShared">
      <IconStyle>
        <scale>1.4</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/paddle/ylw-stars.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <color>ff00d7ff</color>
        <scale>1.0</scale>
      </LabelStyle>
      <LineStyle>
        <color>ff00d7ff</color>
        <width>3</width>
      </LineStyle>
    </Style>

    <!-- Vector de Línea Donante hacia Azotea (Amarillo/Oro Sólido, Grueso y Visible) -->
    <Style id="styleVectorAzimut">
      <LineStyle>
        <color>ff00ffff</color>
        <width>3.5</width>
      </LineStyle>
    </Style>

    <!-- ======================================================== -->
    <!-- FOLDER 1: CENTRO CONSISTORIAL PAC & PUNTOS DE MEDICIÓN   -->
    <!-- ======================================================== -->
    <Folder>
      <name>🏢 Edificio Consistorial PAC &amp; Zonas Críticas</name>
      <open>1</open>

      <Placemark>
        <name>Edificio Consistorial PAC (Acceso Salvador Allende 2029)</name>
        <styleUrl>#styleEdificio</styleUrl>
        <description><![CDATA[
          <h3>Municipalidad de Pedro Aguirre Cerda</h3>
          <p><b>Dirección:</b> Av. Presidente Salvador Allende N° 2029<br/>
          <b>Contacto:</b> Álvaro Carreño Cerda — Jefe Informática (SECPLA)<br/>
          <b>Diagnóstico RF:</b> Excelente cobertura exterior 4G/5G en calle (-74 dBm). Apagón de señal en Piso -1 por doble losa de hormigón armado de 25 cm.<br/>
          <b>Solución Cotizada:</b> weBoost Office 200 LATAM (SKU 531047).</p>
        ]]></description>
        <Point>
          <altitudeMode>clampToGround</altitudeMode>
          <coordinates>-70.665500,-33.488600,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P1: Azotea Técnica (+8,25 m) — Punto Donante Antena Omni Plus</name>
        <styleUrl>#styleDonante</styleUrl>
        <description><![CDATA[
          <b>Ubicación:</b> Ejes N-P / Azotea sobre Shaft GI 07-08<br/>
          <b>Elemento:</b> Antena Exterior Omni Plus (314422) 360° + Protector Relámpago (859902)<br/>
          <b>RSRP Donante:</b> Entel: -72 dBm | Movistar: -74 dBm | Claro: -68 dBm | WOM: -70 dBm<br/>
          <b>Bajada Coaxial:</b> 18,28 m Wilson400 hacia amplificador.
        ]]></description>
        <Point>
          <altitudeMode>relativeToGround</altitudeMode>
          <extrude>1</extrude>
          <coordinates>-70.665450,-33.488550,15</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P5: Técnicos Informática &amp; Bodega (Nivel -1)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Subterráneo Cota -3,20 m:</b> RSRP -108 dBm (Borde de corte de llamada).
        ]]></description>
        <Point>
          <altitudeMode>clampToGround</altitudeMode>
          <coordinates>-70.665420,-33.488620,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P6: Oficina Álvaro Carreño — Informática (ZONA MUERTA)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Subterráneo Cota -3,20 m:</b> RSRP -114 dBm | SINR &lt; 0 dB.<br/>
          <b>Falla:</b> CALL DROP (Llamadas se caen o no timbran).<br/>
          <b>Punto objetivo:</b> Aquí irradia la Antena Domo Interior Wilson (314407).
        ]]></description>
        <Point>
          <altitudeMode>clampToGround</altitudeMode>
          <coordinates>-70.665380,-33.488650,0</coordinates>
        </Point>
      </Placemark>

      <Placemark>
        <name>P8: Archivo Municipal (APAGÓN TOTAL DE SEÑAL)</name>
        <styleUrl>#stylePuntoCritico</styleUrl>
        <description><![CDATA[
          <b>Subterráneo Fondo Enterrado:</b> RSRP &lt; -120 dBm / Sin Servicio (Solo Emergencias).
        ]]></description>
        <Point>
          <altitudeMode>clampToGround</altitudeMode>
          <coordinates>-70.665250,-33.488750,0</coordinates>
        </Point>
      </Placemark>
    </Folder>

